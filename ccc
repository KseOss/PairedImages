using Microsoft.Maui.Controls;
using System.Collections.ObjectModel;

namespace StudentInfoApp
{
    public partial class MainPage : TabbedPage
    {
        public ObservableCollection<Student> Students { get; set; }
        private Student selectedStudent;

        public MainPage()
        {
            InitializeComponent();
            Students = new ObservableCollection<Student>();
            studentsListView.ItemsSource = Students;
        }

        private void dateBirth_DateSelected(object sender, DateChangedEventArgs e)
        {
            int age = DateTime.Now.Year - dateBirth.Date.Year;
            if (DateTime.Now.Month < dateBirth.Date.Month || 
                (DateTime.Now.Month == dateBirth.Date.Month && 
                 DateTime.Now.Day < dateBirth.Date.Day))
            {
                age--;
            }
            this.age.Text = $"Возраст - {age}";
        }

        private void MathStepper_ValueChanged(object sender, ValueChangedEventArgs e)
        {
            mathGrade.Text = mathStepper.Value.ToString("0");
        }

        private void ProgrammingStepper_ValueChanged(object sender, ValueChangedEventArgs e)
        {
            programmingGrade.Text = programmingStepper.Value.ToString("0");
        }

        private void EnglishSlider_ValueChanged(object sender, ValueChangedEventArgs e)
        {
            englishGrade.Text = englishSlider.Value.ToString("0.0");
        }

        private void AddPhotoBtn_Clicked(object sender, System.EventArgs e)
        {
            studentPhoto.Source = ImageSource.FromFile("dotnet_bot.svg");
        }

        private void SaveStudent_Clicked(object sender, System.EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(lastName.Text) || string.IsNullOrWhiteSpace(firstName.Text))
            {
                DisplayAlert("Ошибка", "Заполните обязательные поля (Фамилия и Имя)", "OK");
                return;
            }

            var student = new Student
            {
                LastName = lastName.Text,
                FirstName = firstName.Text,
                MiddleName = middleName.Text,
                BirthDate = dateBirth.Date,
                Age = CalculateAge(dateBirth.Date),
                Gender = genderPicker.SelectedItem?.ToString() ?? "Не указан",
                NeedsDormitory = dormitorySwitch.On,
                IsMonitor = monitorSwitch.On,
                MathGrade = mathGrade.Text,
                ProgrammingGrade = programmingGrade.Text,
                EnglishGrade = englishGrade.Text,
                AdditionalInfo = additionalInfo.Text,
                Photo = studentPhoto.Source
            };

            Students.Add(student);
            ClearForm();
            DisplayAlert("Успех", "Студент добавлен в список", "OK");
            
            // Переключаемся на вкладку со списком
            CurrentPage = Children[1];
        }

        private void StudentsListView_ItemSelected(object sender, SelectedItemChangedEventArgs e)
        {
            selectedStudent = e.SelectedItem as Student;
            editButton.IsEnabled = selectedStudent != null;
            deleteButton.IsEnabled = selectedStudent != null;
        }

        private async void EditButton_Clicked(object sender, System.EventArgs e)
        {
            if (selectedStudent == null) return;

            // Загружаем данные выбранного студента в форму редактирования
            await Navigation.PushAsync(new EditStudentPage(selectedStudent, Students));
        }

        private async void DeleteButton_Clicked(object sender, System.EventArgs e)
        {
            if (selectedStudent == null) return;

            bool result = await DisplayAlert("Подтверждение", 
                $"Вы действительно хотите удалить студента {selectedStudent.FullName}?", 
                "Да", "Нет");

            if (result)
            {
                Students.Remove(selectedStudent);
                selectedStudent = null;
                editButton.IsEnabled = false;
                deleteButton.IsEnabled = false;
            }
        }

        private int CalculateAge(DateTime birthDate)
        {
            int age = DateTime.Now.Year - birthDate.Year;
            if (DateTime.Now.Month < birthDate.Month || 
                (DateTime.Now.Month == birthDate.Month && DateTime.Now.Day < birthDate.Day))
            {
                age--;
            }
            return age;
        }

        private void ClearForm()
        {
            lastName.Text = string.Empty;
            firstName.Text = string.Empty;
            middleName.Text = string.Empty;
            dateBirth.Date = DateTime.Now;
            age.Text = "Возраст - ";
            genderPicker.SelectedIndex = -1;
            dormitorySwitch.On = false;
            monitorSwitch.On = false;
            mathStepper.Value = 5;
            programmingStepper.Value = 5;
            englishSlider.Value = 5;
            additionalInfo.Text = string.Empty;
            studentPhoto.Source = ImageSource.FromFile("dotnet_bot.svg");
        }
    }
}