<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:StudentInfoApp"
            x:Class="StudentInfoApp.MainPage"
            Title="Анкета студента">
    
    <!-- Вкладка для добавления нового студента -->
    <ContentPage Title="Добавить студента">
        <ScrollView>
            <TableView Intent="Form" HeightRequest="800">
                <TableRoot>
                    <!-- Персональные данные -->
                    <TableSection Title="Персональные данные">
                        <EntryCell x:Name="lastName" Label="Фамилия" Placeholder="Введите фамилию"/>
                        <EntryCell x:Name="firstName" Label="Имя" Placeholder="Введите имя"/>
                        <EntryCell x:Name="middleName" Label="Отчество" Placeholder="Введите отчество"/>
                        
                        <ViewCell>
                            <StackLayout Orientation="Horizontal" Margin="15,0,15,0">
                                <Label Text="Дата рождения" VerticalOptions="Center"/>
                                <DatePicker x:Name="dateBirth" DateSelected="dateBirth_DateSelected" 
                                           HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </ViewCell>
                        
                        <TextCell x:Name="age" Text="Возраст - "/>
                        
                        <ViewCell>
                            <StackLayout Orientation="Horizontal" Margin="15,0,15,0">
                                <Label Text="Пол" VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Picker x:Name="genderPicker" Title="Выберите пол" HorizontalOptions="FillAndExpand">
                                    <Picker.Items>
                                        <x:String>Мужской</x:String>
                                        <x:String>Женский</x:String>
                                    </Picker.Items>
                                </Picker>
                            </StackLayout>
                        </ViewCell>
                    </TableSection>

                    <!-- Фото -->
                    <TableSection Title="Фотография">
                        <ViewCell>
                            <StackLayout Orientation="Vertical" Padding="15,10">
                                <Button x:Name="addPhotoBtn" Text="Добавить фото" 
                                        Clicked="AddPhotoBtn_Clicked" HorizontalOptions="Center"/>
                                <Image x:Name="studentPhoto" Source="dotnet_bot.svg" 
                                       Aspect="AspectFit" HeightRequest="150" 
                                       HorizontalOptions="Center" Margin="0,10,0,0"/>
                            </StackLayout>
                        </ViewCell>
                    </TableSection>

                    <!-- Проживание -->
                    <TableSection Title="Проживание">
                        <SwitchCell x:Name="dormitorySwitch" Text="Нужно общежитие"/>
                    </TableSection>

                    <!-- Староста -->
                    <TableSection Title="Должность">
                        <SwitchCell x:Name="monitorSwitch" Text="Является старостой"/>
                    </TableSection>

                    <!-- Оценки -->
                    <TableSection Title="Оценки">
                        <ViewCell>
                            <StackLayout Orientation="Horizontal" Margin="15,10">
                                <Label Text="Математика" VerticalOptions="Center" HorizontalOptions="Start"/>
                                <Label x:Name="mathGrade" Text="5" VerticalOptions="Center" Margin="10,0"/>
                                <Stepper x:Name="mathStepper" Minimum="2" Maximum="5" Increment="1" Value="5"
                                       ValueChanged="MathStepper_ValueChanged" HorizontalOptions="EndAndExpand"/>
                            </StackLayout>
                        </ViewCell>
                        
                        <ViewCell>
                            <StackLayout Orientation="Horizontal" Margin="15,10">
                                <Label Text="Программирование" VerticalOptions="Center" HorizontalOptions="Start"/>
                                <Label x:Name="programmingGrade" Text="5" VerticalOptions="Center" Margin="10,0"/>
                                <Stepper x:Name="programmingStepper" Minimum="2" Maximum="5" Increment="1" Value="5"
                                       ValueChanged="ProgrammingStepper_ValueChanged" HorizontalOptions="EndAndExpand"/>
                            </StackLayout>
                        </ViewCell>
                        
                        <ViewCell>
                            <StackLayout Orientation="Horizontal" Margin="15,10">
                                <Label Text="Английский язык" VerticalOptions="Center" HorizontalOptions="Start"/>
                                <Label x:Name="englishGrade" Text="5" VerticalOptions="Center" Margin="10,0"/>
                                <Slider x:Name="englishSlider" Minimum="2" Maximum="5" Value="5"
                                       ThumbColor="Blue" MinimumTrackColor="Green" MaximumTrackColor="Red"
                                       ValueChanged="EnglishSlider_ValueChanged" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </ViewCell>
                    </TableSection>

                    <!-- Дополнительная информация -->
                    <TableSection Title="Дополнительно">
                        <EntryCell x:Name="additionalInfo" Label="Доп. информация" Placeholder="Хобби, увлечения..."/>
                        
                        <ViewCell>
                            <Button Text="Сохранить студента" Clicked="SaveStudent_Clicked" 
                                    BackgroundColor="LightGreen" Margin="15,10"/>
                        </ViewCell>
                    </TableSection>
                </TableRoot>
            </TableView>
        </ScrollView>
    </ContentPage>

    <!-- Вкладка для просмотра всех студентов -->
    <ContentPage Title="Список студентов">
        <StackLayout>
            <ListView x:Name="studentsListView" ItemSelected="StudentsListView_ItemSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Padding="10" Orientation="Horizontal">
                                <Image Source="{Binding Photo}" Aspect="AspectFill" 
                                       WidthRequest="50" HeightRequest="50"/>
                                <StackLayout Margin="10,0" VerticalOptions="Center">
                                    <Label Text="{Binding FullName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding AgeInfo}" FontSize="Small"/>
                                    <Label Text="{Binding GradesInfo}" FontSize="Small"/>
                                </StackLayout>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            <!-- Кнопки управления -->
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,10">
                <Button x:Name="editButton" Text="Редактировать" Clicked="EditButton_Clicked" 
                        BackgroundColor="LightBlue" Margin="5" IsEnabled="False"/>
                <Button x:Name="deleteButton" Text="Удалить" Clicked="DeleteButton_Clicked" 
                        BackgroundColor="LightCoral" Margin="5" IsEnabled="False"/>
            </StackLayout>
        </StackLayout>
    </ContentPage>
</TabbedPage>